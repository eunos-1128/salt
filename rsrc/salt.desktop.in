[Desktop Entry]
Type=Application
Name=Salt Terminal
Comment=Alternative command line and SSH terminal
Comment[nl]=Alternatieve opdracht prompt en SSH terminal
Exec=@__EXE__@ %u
Icon=@__ICON__@
Categories=GNOME;GTK;System;TerminalEmulator
Keywords=ssh;shell;prompt;command;commandline;cmd;
MimeType=x-scheme-handler/ssh
Actions=new-terminal;connect

[Desktop Action new-terminal]
Name=New Terminal
Name[nl]=Nieuwe terminal
Exec=env GDK_BACKEND=x11 @__EXE__@

[Desktop Action connect]
Name=Open Connection
Name[nl]=Verbind met server
Exec=env GDK_BACKEND=x11 @__EXE__@ --select-host
